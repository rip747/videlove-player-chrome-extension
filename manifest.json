{
  "manifest_version": 3,
  "name": "VidLove for TMDB",
  "version": "1.1.0",
  "description": "Adds \"Watch\" buttons that deep link movies, TV shows, seasons and episodes from The Movie Database (themoviedb.org) into the VidLove player.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.themoviedb.org/movie/*",
        "https://www.themoviedb.org/tv/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
